# NetScope Application Environment Configuration

# Core
NETSCOPE_APP_NAME="NetScope"
NETSCOPE_APP_VERSION="0.1.0"
NETSCOPE_ENVIRONMENT="development"
NETSCOPE_DEBUG="false"

# Server Host & Port
NETSCOPE_HOST="127.0.0.1"
NETSCOPE_PORT=8000

# Ingestion Constraints
# 25 MB max upload for Phase 1 local MVP (in bytes: 26214400)
NETSCOPE_MAX_UPLOAD_BYTES=26214400
NETSCOPE_MAX_SAMPLED_PACKETS=100

# Security & CORS
NETSCOPE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
