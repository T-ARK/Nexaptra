# NetScope Tactical PCAP Forensics Platform
# Developed by ARK (https://github.com/T-ARK)

# Core Application Settings
NETSCOPE_APP_NAME="NetScope"
NETSCOPE_APP_VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG="false"

# Production Server Binding (Render binds to dynamic $PORT)
HOST="0.0.0.0"
PORT=8000

# Ingestion Limits (Default: 50MB in bytes)
MAX_UPLOAD_BYTES=52428800
NETSCOPE_MAX_SAMPLED_PACKETS=150

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"
